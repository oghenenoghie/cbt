APP_NAME="Intelligent CBT API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

DATABASE_URL="sqlite:///./cbt.db"
# PostgreSQL from infrastructure/docker/compose.yaml (note the +psycopg driver):
# DATABASE_URL="postgresql+psycopg://cbt:<password>@localhost:5432/cbt"

# Add storage and AI provider credentials only to local .env files
# or deployment secret managers. Never commit real credentials.

# Sign-in sessions and failed-login throttling (defaults shown; see ADR 0001).
# SESSION_MAX_AGE_MINUTES=480
# SESSION_IDLE_TIMEOUT_MINUTES=60
# SESSION_COOKIE_SECURE=true
# LOGIN_MAX_FAILURES=5
# LOGIN_THROTTLE_WINDOW_MINUTES=15

# Learning materials (ADR 0004; defaults shown).
# STORAGE_DIR=./storage          # where uploaded originals are kept
# DOCUMENT_MAX_MB=25
# DOCUMENT_MAX_PAGES=1000
# DOCUMENT_MAX_UNZIPPED_MB=200
# "inline" processes uploads in the API process (development); "worker" leaves them for
# `python -m app.worker` (production).
# DOCUMENT_PROCESSING=inline
