APP_NAME="Intelligent CBT API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

DATABASE_URL="sqlite:///./cbt.db"
# PostgreSQL from infrastructure/docker/compose.yaml (note the +psycopg driver):
# DATABASE_URL="postgresql+psycopg://cbt:<password>@localhost:5432/cbt"

# Add storage and AI provider credentials only to local .env files
# or deployment secret managers. Never commit real credentials.

# Sign-in sessions and failed-login throttling (defaults shown; see ADR 0001).
# SESSION_MAX_AGE_MINUTES=480
# SESSION_IDLE_TIMEOUT_MINUTES=60
# SESSION_COOKIE_SECURE=true
# LOGIN_MAX_FAILURES=5
# LOGIN_THROTTLE_WINDOW_MINUTES=15

# Learning materials (ADR 0004; defaults shown).
# STORAGE_DIR=./storage          # where uploaded originals are kept
# DOCUMENT_MAX_MB=25
# DOCUMENT_MAX_PAGES=1000
# DOCUMENT_MAX_UNZIPPED_MB=200
# "inline" processes uploads in the API process (development); "worker" leaves them for
# `python -m app.worker` (production).
# DOCUMENT_PROCESSING=inline

# AI question drafts (ADR 0005; defaults shown).
# "off" (drafting unavailable), "anthropic" (Claude) or "fake" (deterministic questions from
# the materials, for trying the flow without a key or any cost).
# AI_PROVIDER=off
# With AI_PROVIDER=anthropic the SDK reads the key from ANTHROPIC_API_KEY. Put it only in a
# local .env or the deployment's secret manager, never in git.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=high                 # low, medium, high, xhigh or max; empty for the model default
# AI_FALLBACKS=true              # let the API retry on a suitable model if the safeguards decline
# AI_MAX_OUTPUT_TOKENS=32000
# AI_TIMEOUT_SECONDS=600
# AI_CHECK_ANSWERS=true          # the second pass that checks each answer against its quotes
# AI_PROCESSING=inline           # or "worker", as for documents
# AI_MAX_QUESTIONS=20            # per request
# AI_MAX_SOURCES=30              # parts of the materials per request
# AI_MAX_SOURCE_CHARS=60000
# AI_MONTHLY_REQUESTS=200        # per school; 0 for no limit
# AI_MAX_OPEN_REQUESTS=3         # per school, being drafted at once
# US dollars per million tokens, for each request's cost estimate:
# AI_PRICE_INPUT=4.0
# AI_PRICE_OUTPUT=20.0
# AI_PRICE_CACHE_READ=0.2
# AI_PRICE_CACHE_WRITE=5.0
