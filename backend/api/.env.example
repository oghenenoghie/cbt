APP_NAME="Intelligent CBT API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

DATABASE_URL="sqlite:///./cbt.db"
# PostgreSQL from infrastructure/docker/compose.yaml (note the +psycopg driver):
# DATABASE_URL="postgresql+psycopg://cbt:<password>@localhost:5432/cbt"

# Add storage and AI provider credentials only to local .env files
# or deployment secret managers. Never commit real credentials.

# Sign-in sessions and failed-login throttling (defaults shown; see ADR 0001).
# SESSION_MAX_AGE_MINUTES=480
# SESSION_IDLE_TIMEOUT_MINUTES=60
# SESSION_COOKIE_SECURE=true
# LOGIN_MAX_FAILURES=5
# LOGIN_THROTTLE_WINDOW_MINUTES=15

# Integrations (ADR 0008): requests per minute for each integration, across all its keys.
# INTEGRATION_RATE_LIMIT_PER_MINUTE=120
# INTEGRATION_MAX_BODY_KB=64        # largest request body an integration may send

# Learning materials (ADR 0004; defaults shown).
# STORAGE_DIR=./storage          # where uploaded originals are kept
# DOCUMENT_MAX_MB=25
# DOCUMENT_MAX_PAGES=1000
# DOCUMENT_MAX_UNZIPPED_MB=200
# "inline" processes uploads in the API process (development); "worker" leaves them for
# `python -m app.worker` (production).
# DOCUMENT_PROCESSING=inline
# Scan every upload before persistence. Production must use "clamd"; dev/tests may disable it.
# DOCUMENT_MALWARE_SCAN_MODE=clamd
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_SECONDS=10
# Scan before storage/extraction. Production must set this to "clamd".
# DOCUMENT_MALWARE_SCAN_MODE=clamd
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_TIMEOUT_SECONDS=10
# OCR of scanned pages and photos, when Tesseract is installed (apt-get install tesseract-ocr).
# OCR_ENABLED=true
# TESSERACT_CMD=tesseract
# OCR_LANGUAGES=eng              # e.g. eng+fra; install a language pack for each
# OCR_DPI=300
# OCR_MIN_CONFIDENCE=0.6         # below this, text is flagged and not used for AI drafts
# OCR_MAX_PAGES=200              # scanned pages read per file
# OCR_TIMEOUT_SECONDS=120        # per page
# IMAGE_MAX_MEGAPIXELS=40

# AI question drafts (ADR 0005; defaults shown).
# "off" (drafting unavailable), "anthropic" (Claude) or "fake" (deterministic questions from
# the materials, for trying the flow without a key or any cost).
# AI_PROVIDER=off
# With AI_PROVIDER=anthropic the SDK reads the key from ANTHROPIC_API_KEY. Put it only in a
# local .env or the deployment's secret manager, never in git.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=high                 # low, medium, high, xhigh or max; empty for the model default
# AI_FALLBACKS=true              # let the API retry on a suitable model if the safeguards decline
# AI_MAX_OUTPUT_TOKENS=32000
# AI_TIMEOUT_SECONDS=600
# AI_CHECK_ANSWERS=true          # the second pass that checks each answer against its quotes
# AI_PROCESSING=inline           # or "worker", as for documents
# AI_MAX_QUESTIONS=20            # per request
# AI_MAX_SOURCES=30              # parts of the materials per request
# AI_MAX_SOURCE_CHARS=60000
# AI_MONTHLY_REQUESTS=200        # per school; 0 for no limit
# AI_MAX_OPEN_REQUESTS=3         # per school, being drafted at once
# US dollars per million tokens, for each request's cost estimate:
# AI_PRICE_INPUT=4.0
# AI_PRICE_OUTPUT=20.0
# AI_PRICE_CACHE_READ=0.2
# AI_PRICE_CACHE_WRITE=5.0

# Offline exams on lab computers (ADR 0007; defaults shown).
# The key that signs exam packages. Production: configure exactly one source.
# Environment secret (base64 32-byte Ed25519 seed):
# OFFLINE_SIGNING_KEY=
# Or a read-only mounted secret file (POSIX permissions 0400 or 0600):
# OFFLINE_SIGNING_KEY_FILE=/run/secrets/cbt_offline_signing_key
# Pinned public half of the separate offline trust root (base64 raw 32-byte Ed25519 key).
# The root private key must remain offline and must never be mounted into the API service.
# OFFLINE_TRUST_ROOT_PUBLIC_KEY=
# Development servers without either setting generate STORAGE_DIR/offline-signing.key.
# Record/check the public-key fingerprint with: python -m app.cli signing-key-fingerprint
# DEVICE_REGISTRATION_HOURS=24
# OFFLINE_PACKAGE_DAYS=14
# OFFLINE_CODE_ITERATIONS=200000
# OFFLINE_TIME_ALLOWANCE_MINUTES=10
# Where the lab app's newest installer and its signed manifest are kept (default STORAGE_DIR/lab-app).
# LAB_APP_DIR=/srv/cbt/lab-app
